@using BelegOCR.Models
@model BelegOCR.Models.ExtractedTable
@{
    var de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    string Amount(decimal? v) => v?.ToString("N2", de) ?? "";

    // Wert einer Zelle passend zum Datentyp formatieren. Konnte der Rohtext nicht
    // geparst werden (Value null, Cell gefüllt), wird der Rohtext angezeigt und markiert.
    (string Text, bool ParseFailed) Format(ExtractedTableRow r, ExtractedTableColumn c)
    {
        var raw = r.Cells.TryGetValue(c.Key, out var cell) ? cell
                : r.Cells.TryGetValue(c.HeaderText, out var legacy) ? legacy   // Belege vor der Umstellung
                : "";
        switch (c.DataType)
        {
            case TableDataTypes.Amount:
            case TableDataTypes.Number:
                var d = r.GetDecimal(c.Key);
                if (d == null) return (raw, !string.IsNullOrWhiteSpace(raw));
                return (c.DataType == TableDataTypes.Amount ? Amount(d) : d.Value.ToString("0.###", de), false);
            case TableDataTypes.Date:
                var iso = r.GetText(c.Key);
                if (iso == null) return (raw, !string.IsNullOrWhiteSpace(raw));
                return (DateTime.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.None, out var dt) ? dt.ToString("dd.MM.yyyy", de) : iso, false);
            default:
                return (r.GetText(c.Key) ?? raw, false);
        }
    }

    bool hasRowCheck = Model.KeyOf(TableRoles.Quantity) != null &&
                       Model.KeyOf(TableRoles.UnitPrice) != null &&
                       Model.KeyOf(TableRoles.Total) != null;
}

<h5 class="mt-3">▦ @Model.FieldName</h5>

<div class="table-result-meta">
    <span>@Model.Rows.Count Positionen</span>
    @if (Model.Rows.Any(r => r.Uncertain))
    {
        <span class="badge badge-warning">@Model.Rows.Count(r => r.Uncertain) zur manuellen Prüfung</span>
    }
    @if (Model.Rows.Any(r => r.RowCheckOk == false))
    {
        <span class="badge badge-danger">@Model.Rows.Count(r => r.RowCheckOk == false) × Menge·Preis ≠ Gesamt</span>
    }
    @if (Model.SumCheckOk == true)
    {
        <span class="badge badge-success">Summe @Amount(Model.SumOfTotals) = Gesamtbetrag</span>
    }
    else if (Model.SumCheckOk == false)
    {
        <span class="badge badge-danger">Summe @Amount(Model.SumOfTotals) ≠ Gesamtbetrag @Amount(Model.ExpectedTotal)</span>
    }
    else if (Model.SumOfTotals != null)
    {
        <span>Summe @Amount(Model.SumOfTotals)</span>
    }
    @if (Model.Stats != null)
    {
        <span class="text-muted" title="Abstände relativ zur Schrifthöhe, gelernt aus den sicheren Positionen">
            Zeilenhöhe @Model.Stats.LineHeight px ·
            Positionsabstand @(Model.Stats.PositionGap?.ToString("F2") ?? "–") ·
            Umbruchabstand @(Model.Stats.LineBreakGap?.ToString("F2") ?? "–")
            @(Model.Stats.FallbackMedian ? "(Fallback: Median)" : "")
        </span>
    }
</div>

@foreach (var w in Model.Warnings)
{
    <div class="alert alert-warning mb-1">@w</div>
}

@if (Model.Rows.Count > 0)
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>#</th>
                @foreach (var c in Model.Columns)
                {
                    var align = TableDataTypes.IsNumeric(c.DataType) ? "text-align:right" : "";
                    <th style="@align" title="@c.Key@(string.IsNullOrEmpty(c.Role) ? "" : " · Rolle " + c.Role)">
                        @(string.IsNullOrWhiteSpace(c.HeaderText) ? c.Key : c.HeaderText)
                    </th>
                }
                <th>Konfidenz</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            var css = r.RowCheckOk == false ? "row-check-fail" : r.Uncertain ? "row-uncertain" : "";
            <tr class="@css">
                <td>@r.RowNo</td>
                @foreach (var c in Model.Columns)
                {
                    var (text, failed) = Format(r, c);
                    var align = TableDataTypes.IsNumeric(c.DataType) ? "text-align:right" : "";
                    if (failed)
                    {
                        <td style="@align" class="text-danger" title="Wert konnte nicht als @c.DataType gelesen werden">@text</td>
                    }
                    else
                    {
                        <td style="@align">@text</td>
                    }
                }
                <td>@r.Confidence.ToString("F1") %</td>
                <td>
                    @if (r.Uncertain) { <span title="@r.UncertainReason">⚠ unsicher</span> }
                    @if (hasRowCheck && r.RowCheckOk == false) { <span title="Menge × Einzelpreis ≠ Gesamt">✗ Prüfung</span> }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
